---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = ".folder — namespace registry",
  description = "One shared directory for all your dev tool configs. Claim a namespace, avoid collisions, keep your repo root clean.",
  ogImage = "/og.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://dotfolder.xyz");
const ogImageURL = new URL(ogImage, "https://dotfolder.xyz").href;
const isHomePage = Astro.url.pathname === "/";

const user = Astro.locals.user ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content=".folder" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions />
  </head>
  <body>
    <header>
      <a href="/" class="logo"><span class="logo-muted">.</span>folder</a>
      <div class="header-right">
        {
          user ? (
            <a href="/dashboard" class="header-user">
              {user.avatar_url && (
                <img src={user.avatar_url} alt="" class="header-avatar" />
              )}
              @{user.username}
            </a>
          ) : (
            <a href="/api/auth/github" class="header-login">
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
              </svg>
              sign in
            </a>
          )
        }
      </div>
    </header>

    <slot />

    <footer class:list={["legal-footer", { "legal-footer-fixed": isHomePage }]}>
      <a href="/mission">mission</a>
      <span>·</span>
      <a href="/presskit">presskit</a>
      <span>·</span>
      <a href="/terms">terms</a>
      <span>·</span>
      <a href="/privacy">privacy</a>
    </footer>

    <div class="toast" id="toast"></div>
  </body>
</html>
