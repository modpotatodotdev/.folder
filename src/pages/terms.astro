---
import Layout from "../layouts/Layout.astro";
---

<Layout title=".folder — terms" description="Terms of Service for the .folder namespace registry.">
  <main class="dashboard-page">
    <h1 style="font-family:var(--serif);font-size:2rem;margin-bottom:1rem;">
      Terms of Service
    </h1>
    <p
      style="font-size:0.75rem;color:var(--muted);line-height:1.9;margin-bottom:1rem;"
    >
      By using .folder, you agree not to abuse the service, upload malicious
      content, or violate applicable laws. You are responsible for the namespace
      metadata you submit and must have the right to publish it.
    </p>
    <p
      style="font-size:0.75rem;color:var(--muted);line-height:1.9;margin-bottom:1rem;"
    >
      The service is provided “as is” without warranties. We may remove content
      or suspend access to protect users, comply with legal obligations, or
      maintain platform security.
    </p>
    <p style="font-size:0.75rem;color:var(--muted);line-height:1.9;">
      Continued use of the service means you accept updates to these terms.
    </p>
  </main>
</Layout>
