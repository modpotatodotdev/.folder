---
import Layout from "../layouts/Layout.astro";
---

<Layout title=".folder — privacy">
  <main class="dashboard-page">
    <h1 style="font-family:var(--serif);font-size:2rem;margin-bottom:1rem;">
      Privacy Policy
    </h1>
    <p
      style="font-size:0.75rem;color:var(--muted);line-height:1.9;margin-bottom:1rem;"
    >
      .folder collects only the minimum account data needed to operate the
      namespace registry, including your GitHub user ID, username, display name,
      avatar URL, session identifiers, and namespace records that you submit.
    </p>
    <p
      style="font-size:0.75rem;color:var(--muted);line-height:1.9;margin-bottom:1rem;"
    >
      .folder does not sell personal data and does not use submitted data for
      advertising. We use cookies strictly for authentication and session
      management.
    </p>
    <p style="font-size:0.75rem;color:var(--muted);line-height:1.9;">
      Data may be retained to maintain service integrity and comply with legal
      obligations. Contact the project owner through the repository to request
      account-related data updates.
    </p>
  </main>
</Layout>
