    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "^5.8.3",
    "wrangler": "^4.69.0"
  },
  "overrides": {
    "wrangler": "^4.69.0",
    "undici": "^7.18.2"
  }
}
